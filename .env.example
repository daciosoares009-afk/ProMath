# Em desenvolvimento sem Firebase, a API usa SQLite local.
# Para testar o Firebase no Vite, use PROBMATH_BACKEND=firebase.
PROBMATH_BACKEND=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Configuração pública do aplicativo Web, Firebase Console > Configurações do projeto.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=

